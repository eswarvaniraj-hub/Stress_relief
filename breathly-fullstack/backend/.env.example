# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed to call this API (your Live Server URL)
FRONTEND_ORIGIN=http://127.0.0.1:5500

# Google OAuth — same Client ID your frontend already uses
GOOGLE_CLIENT_ID=566164333122-o2u5sgtqueto8d2t9b7ufquugiqq8g7l.apps.googleusercontent.com

# PostgreSQL Configuration
# Option A: Connection string (e.g. Supabase, Neon, Render, Railway)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/breathly

# Option B: Individual parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=breathly
DB_SSL=false

# Session
SESSION_SECRET=your_random_64_character_hex_secret_here